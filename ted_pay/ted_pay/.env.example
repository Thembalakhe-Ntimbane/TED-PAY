# Copy to .env  (cp .env.example .env)  — .env is git-ignored. Never commit real keys.
# Leave SECRET_KEY empty to auto-generate one into instance/secret.key on first run.
SECRET_KEY=
HOST=0.0.0.0
PORT=5000
# Set to 1 only for local development
DEBUG=0

# --- Rate engine ---------------------------------------------------------
# coingecko = live ZAR/USDT (needs internet), fixed = always use FALLBACK_ZAR_PER_USDT
RATE_SOURCE=coingecko
FALLBACK_ZAR_PER_USDT=18.50
QUOTE_TTL_SECONDS=60

# --- Tether Testnet ledger -----------------------------------------------
# simulated = built-in testnet ledger (default, no keys needed)
# wdk       = adapter hook for a real Tether WDK testnet node (see README)
CHAIN_MODE=simulated
CONFIRM_SECONDS_MIN=3
CONFIRM_SECONDS_MAX=6
FAUCET_USDT=500
# Reserved for the real-testnet adapter (leave blank here; keep real values only in your private .env)
WDK_RPC_URL=
WDK_PROTOTYPE_ACCOUNT_SEED=

# --- Misc ----------------------------------------------------------------
# Show password-reset link on screen (dev only). In production wire up SMTP instead.
DEV_SHOW_RESET_LINK=1
SESSION_COOKIE_SECURE=0
