# Copy to .env (git-ignored). NEVER commit real values. NEVER put private keys / seed phrases here.
# Everything in .env is bundled into the app binary and is therefore PUBLIC-ish: only non-secret endpoints belong here.
APP_ENV=development
USE_MOCK_WDK=true
# Testnet EVM JSON-RPC endpoint (Sepolia by default; swap for the Tether-designated testnet)
RPC_URL=https://rpc.sepolia.org
CHAIN_ID=11155111
# Test USDT (ERC-20) contract on that testnet
USDT_CONTRACT=0x0000000000000000000000000000000000000000
# Live ZAR/USDT rate source (JSON: {"tether":{"zar":18.1}})
RATE_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=tether&vs_currencies=zar
# Optional: key for a paid rate provider; for production proxy this via your own backend instead
RATE_API_KEY=
PAY_LINK_BASE=https://pay.tedpay.co.za/p
LEDGER_POLL_MS=3000
