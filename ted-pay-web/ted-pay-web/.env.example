# Copy to .env.local (git-ignored). Everything VITE_* is shipped to the browser: PUBLIC values only, never keys/seeds.
# true  = simulated chain in this browser (works across tabs; no gas/tokens needed) - ideal for demos
# false = real testnet via ethers + RPC below
VITE_MOCK_CHAIN=true
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_CHAIN_ID=11155111
# Test USDT (ERC-20) contract on that testnet
VITE_USDT_CONTRACT=0x0000000000000000000000000000000000000000
VITE_RATE_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=tether&vs_currencies=zar
VITE_LEDGER_POLL_MS=2500
